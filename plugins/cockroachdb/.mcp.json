{
  "mcpServers": {
    "cockroachdb-cloud": {
      "type": "http",
      "url": "https://cockroachlabs.cloud/mcp",
      "env_http_headers": {
        "mcp-cluster-id": "COCKROACHDB_CLUSTER_ID"
      }
    },
    "cockroachdb-toolbox": {
      "command": "toolbox",
      "args": ["--config", "./tools.yaml", "--stdio"],
      "cwd": ".",
      "env_vars": [
        "COCKROACHDB_HOST",
        "COCKROACHDB_PORT",
        "COCKROACHDB_USER",
        "COCKROACHDB_PASSWORD",
        "COCKROACHDB_DATABASE",
        "COCKROACHDB_SSLMODE"
      ]
    },
    "cockroachdb-toolbox-http": {
      "type": "http",
      "url": "http://127.0.0.1:5000/mcp",
      "_comment": "SSE transport — run 'toolbox --config tools.yaml' first, then connect via this URL"
    }
  }
}
