{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__cockroachdb-toolbox__cockroachdb-execute-sql",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/validate-sql.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/check-sql-files.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
